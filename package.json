{
  "name": "impact",
  "version": "2.1.2",
  "description": "Ghost blogging theme",
  "engines": {
    "ghost": ">=6.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "Eduardo Chiaro",
    "email": "e.chiaro@gmail.com",
    "url": "https://www.eduardochiaro.com"
  },
  "scripts": {
    "dev": "gulp",
    "zip": "gulp zip",
    "design": "gulp design"
  },
  "gpm": {
    "type": "theme",
    "categories": [
      "Blog"
    ]
  },
  "keywords": [
    "ghost",
    "theme",
    "ghost-theme"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "autoprefixer": "^10.4.27",
    "beeper": "^3.0.0",
    "browser-sync": "^3.0.4",
    "connect-livereload": "^0.6.1",
    "cssnano": "^7.1.3",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-noop": "^1.0.1",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-uglify": "^3.0.2",
    "gulp-zip": "^6.1.0",
    "handlebars": "^4.7.9",
    "jquery": "^4.0.0",
    "livereload": "^0.10.3",
    "minimist": "^1.2.8",
    "node-sass": "^9.0.0",
    "open": "^11.0.0",
    "postcss": "^8.5.8",
    "postcss-color-mod-function": "^4.1.1",
    "pump": "^3.0.4",
    "sass": "^1.98.0",
    "tailwindcss": "^4.2.2"
  },
  "config": {
    "posts_per_page": 9,
    "custom": {
      "subscribe_homepage_banner": {
        "type": "boolean",
        "default": false,
        "group": "homepage"
      },
      "subscribe_homepage_text": {
        "type": "text",
        "default": "Sign up now to get access members-only posts.",
        "group": "homepage"
      },
      "subscribe_post_banner": {
        "type": "boolean",
        "default": false,
        "group": "post"
      },
      "login_header_link": {
        "type": "boolean",
        "default": false
      },
      "show_author": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "targets": {
    "main": {
      "includeNodeModules": {
        "*.scss": true
      }
    }
  }
}
